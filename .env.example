# Wszystkie zmienne są tylko po stronie serwera (bez prefiksu NEXT_PUBLIC_).
# Prawdziwe wartości: .env lokalnie (poza gitem) i magazyn zmiennych Vercel (Production).

# Połączenie aplikacji z PostgreSQL. Lokalnie: kontener z compose.yaml.
# Production: adres pooled (host z "-pooler") roli runtime, z sslmode=require.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/shop_db?schema=public"

# Testy integracyjne: osobna lokalna baza, nazwa musi kończyć się na _test.
# Baza jest kasowana i tworzona od zera przy każdym uruchomieniu testów.
TEST_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/shop_test?schema=public"

# Kontener PostgreSQL (compose.yaml czyta .env.db)
POSTGRES_DB=shop_db
POSTGRES_USER=USER
POSTGRES_PASSWORD=PASSWORD

# Stały adres bazowy aplikacji. Lokalnie http://localhost:3000,
# Production: https://NAZWA.vercel.app
BETTER_AUTH_URL=http://localhost:3000

# Losowy sekret środowiska, min. 32 znaki (openssl rand -base64 32). Osobny dla każdego środowiska.
BETTER_AUTH_SECRET=

# Dane OAuth App GitHub. Osobna aplikacja dla localhost i osobna dla Production.
# Callback: <BETTER_AUTH_URL>/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
